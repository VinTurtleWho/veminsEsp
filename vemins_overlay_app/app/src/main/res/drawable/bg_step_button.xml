<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/imgui_button_hover" />
            <corners android:radius="2dp" />
            <stroke
                android:width="1dp"
                android:color="@color/imgui_accent_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/imgui_button_bg" />
            <corners android:radius="2dp" />
            <stroke
                android:width="1dp"
                android:color="@color/imgui_button_border" />
        </shape>
    </item>
</selector>
