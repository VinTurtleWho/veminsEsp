<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vemins_bg_dark"
    android:orientation="vertical">

    <!-- IMGUI TOP COMMAND BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_imgui_header"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_bubble"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="VEMINS // ESP v2.0"
            android:textColor="@color/imgui_header_title"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderVersionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_badge_cyan"
            android:fontFamily="monospace"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="PRO"
            android:textColor="@color/vemins_white"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_red"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="STOPPED"
            android:textColor="@color/vemins_red"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 1. PERMISSION BANNER -->
            <LinearLayout
                android:id="@+id/cardPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_imgui_window"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="[!] Overlay Permission Required"
                    android:textColor="@color/imgui_accent_amber"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_imgui_button"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="GRANT"
                    android:textColor="@color/imgui_text_primary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- 2. SERVICE CONTROL -->
            <LinearLayout
                android:id="@+id/cardHeroControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_imgui_header"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="## SERVICE CONTROL"
                        android:textColor="@color/imgui_header_title"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvServiceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ENGINE INACTIVE"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvServiceDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Tap START to launch overlay + puck"
                            android:textColor="@color/imgui_text_secondary"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnToggleService"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_imgui_button"
                        android:fontFamily="monospace"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="START"
                        android:textColor="@color/imgui_accent_cyan"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. LIVE SANDBOX PREVIEW -->
            <LinearLayout
                android:id="@+id/cardSandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_imgui_header"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="## LIVE CALIBRATION CANVAS"
                        android:textColor="@color/imgui_header_title"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnTogglePreview"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_imgui_button"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="TOGGLE"
                        android:textColor="@color/imgui_text_primary"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <FrameLayout
                        android:id="@+id/previewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_preview_frame">

                        <com.vemins.esp.view.PreviewCanvasView
                            android:id="@+id/previewCanvas"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPresetDefault"
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="DEFAULT"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="8sp" />

                        <Button
                            android:id="@+id/btnPresetDiamond"
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="DIAMOND"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="8sp" />

                        <Button
                            android:id="@+id/btnPresetCompact"
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="COMPACT"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="8sp" />

                        <Button
                            android:id="@+id/btnPresetWide"
                            android:layout_width="0dp"
                            android:layout_height="22dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="WIDE"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. DIAGNOSTICS & HARDWARE -->
            <LinearLayout
                android:id="@+id/cardDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_imgui_header"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="## SYSTEM DIAGNOSTICS"
                        android:textColor="@color/imgui_header_title"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDaemonStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_badge_red"
                        android:fontFamily="monospace"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="DAEMON: OFF"
                        android:textColor="@color/vemins_red"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvServerStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_red"
                        android:fontFamily="monospace"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="CONN: OFF"
                        android:textColor="@color/vemins_red"
                        android:textSize="8sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvDaemonStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Telemetry: Offline
FPS: -- | PID: --"
                        android:textColor="@color/imgui_text_secondary"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTestPing"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="PING"
                            android:textColor="@color/imgui_text_primary"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnSaveConfig"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="SAVE"
                            android:textColor="@color/imgui_accent_cyan"
                            android:textSize="9sp" />

                        <Button
                            android:id="@+id/btnResetDefaults"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_imgui_button"
                            android:fontFamily="monospace"
                            android:text="RESET"
                            android:textColor="@color/imgui_accent_amber"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. IMGUI TAB SWITCHER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_imgui_header"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabBtnRadar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="RADAR"
                    android:textColor="@color/vemins_white"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/tabBtnCombatHud"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="COMBAT"
                    android:textColor="@color/imgui_text_secondary"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/tabBtnLayers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="LAYERS"
                    android:textColor="@color/imgui_text_secondary"
                    android:textSize="9sp" />

                <Button
                    android:id="@+id/tabBtnStatus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_unselected"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="STATUS"
                    android:textColor="@color/imgui_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- TAB 1: RADAR PANEL -->
            <LinearLayout
                android:id="@+id/panelRadar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="visible">

                <!-- X Offset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Minimap X" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapX" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="75" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapX" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="800" android:progress="75" />

                <!-- Y Offset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Minimap Y" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapY" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="35" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapY" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="800" android:progress="35" />

                <!-- Size -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Radar Size" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapSize" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="342" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapSize" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="800" android:progress="342" />

                <!-- Alpha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Opacity" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapAlpha" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapAlpha" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progress="0" />

                <!-- Hero Radius -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Hero Icon Radius" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapHeroRadius" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="16" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapHeroRadius" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="16" />

                <!-- Rotation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Rotation Deg" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapRotation" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="315" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapRotation" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="315" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnRot0" android:layout_width="0dp" android:layout_height="22dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:background="@drawable/bg_imgui_button" android:fontFamily="monospace" android:text="0°" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                    <Button android:id="@+id/btnRot45" android:layout_width="0dp" android:layout_height="22dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:background="@drawable/bg_imgui_button" android:fontFamily="monospace" android:text="45°" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                    <Button android:id="@+id/btnRot90" android:layout_width="0dp" android:layout_height="22dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:background="@drawable/bg_imgui_button" android:fontFamily="monospace" android:text="90°" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                    <Button android:id="@+id/btnRot180" android:layout_width="0dp" android:layout_height="22dp" android:layout_marginEnd="2dp" android:layout_weight="1" android:background="@drawable/bg_imgui_button" android:fontFamily="monospace" android:text="180°" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                    <Button android:id="@+id/btnRot270" android:layout_width="0dp" android:layout_height="22dp" android:layout_weight="1" android:background="@drawable/bg_imgui_button" android:fontFamily="monospace" android:text="270°" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>

                <!-- Zoom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Radar Zoom" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etMinimapZoom" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="2.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbMinimapZoom" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progress="200" />

                <!-- Stretch X -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Stretch X" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etStretchX" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="1.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbStretchX" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

                <!-- Stretch Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Stretch Y" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etStretchY" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="1.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbStretchY" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

                <CheckBox
                    android:id="@+id/cbMinimapInvertY"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Invert Minimap Y Axis"
                    android:textColor="@color/imgui_text_primary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- TAB 2: COMBAT HUD PANEL -->
            <LinearLayout
                android:id="@+id/panelCombatHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <!-- Scale X -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Camera Scale X" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etScaleX" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="38.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbScaleX" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="80" android:progress="38" />

                <!-- Scale Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Camera Scale Y" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etScaleY" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="27.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbScaleY" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="80" android:progress="27" />

                <!-- HUD Offset Y -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="HUD Vertical Lift" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etHudOffsetY" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="65" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbHudOffsetY" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="65" />

                <!-- Top CD Bar -->
                <CheckBox
                    android:id="@+id/cbShowTopCdBar"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Show Top Enemy CD Bar"
                    android:textColor="@color/imgui_text_primary"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Top CD Bar Y" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etTopCdBarY" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="36" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbTopCdBarY" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progress="36" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Top CD Bar Scale" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etTopCdBarScale" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="1.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbTopCdBarScale" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

                <!-- Badge Radius -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="Badge Radius" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etHudBadgeRadius" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="number" android:text="15" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbHudBadgeRadius" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="40" android:progress="15" />

                <!-- HP Bar Scale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="monospace" android:text="HP Bar Scale" android:textColor="@color/imgui_text_secondary" android:textSize="9sp" />
                    <EditText android:id="@+id/etHudHpBarScale" android:layout_width="55dp" android:layout_height="22dp" android:background="@drawable/bg_input_field" android:fontFamily="monospace" android:gravity="center" android:inputType="numberDecimal" android:text="1.0" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                </LinearLayout>
                <SeekBar android:id="@+id/sbHudHpBarScale" style="@style/CyberSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

                <CheckBox
                    android:id="@+id/cbHighCamera"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="High Camera Mode (Game Setting)"
                    android:textColor="@color/imgui_text_primary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- TAB 3: LAYERS PANEL -->
            <LinearLayout
                android:id="@+id/panelLayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <CheckBox android:id="@+id/cbMinimapEnemies" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Minimap: Enemy Heroes" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbMinimapAllies" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Minimap: Allied Heroes" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbMinimapFacing" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Minimap: Facing Heading Lines" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbMinimapMinions" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Minimap: Minion Waves" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbMinimapMonsters" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Minimap: Jungle Camps" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenHp" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Overhead HP Bars" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenSkillCd" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Skill 1-4 Cooldowns" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenUltBadge" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Ultimate Ready Badges" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenSpellBadge" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Battle Spell Badges" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenDistance" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Distance Labels (Meters)" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbScreenEdgeRadar" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Combat: Screen Edge Radar" android:textColor="@color/imgui_text_primary" android:textSize="9sp" />
                <CheckBox android:id="@+id/cbHideInRecording" android:layout_width="match_parent" android:layout_height="24dp" android:fontFamily="monospace" android:text="Stealth: Hide Overlay in Screen Recording" android:textColor="@color/imgui_accent_cyan" android:textSize="9sp" />
            </LinearLayout>

            <!-- TAB 4: STATUS / JSON PANEL -->
            <LinearLayout
                android:id="@+id/panelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_imgui_window"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="RAW CONFIGURATION JSON"
                    android:textColor="@color/imgui_text_secondary"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/etConfigJson"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="6dp"
                    android:textColor="@color/imgui_text_primary"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExportConfig"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_imgui_button"
                        android:fontFamily="monospace"
                        android:text="EXPORT"
                        android:textColor="@color/imgui_text_primary"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btnImportConfig"
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_imgui_button"
                        android:fontFamily="monospace"
                        android:text="IMPORT"
                        android:textColor="@color/imgui_text_primary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
