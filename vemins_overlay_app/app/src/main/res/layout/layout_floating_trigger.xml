<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingTriggerRoot"
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:background="@drawable/bg_floating_trigger"
    android:clickable="true"
    android:focusable="false">

    <!-- Cyber Core Emblem -->
    <ImageView
        android:id="@+id/ivTriggerIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_bubble"
        android:contentDescription="Trigger Emblem" />

    <!-- Real-Time Telemetry / Daemon Sync Status Dot -->
    <View
        android:id="@+id/vStatusDot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_status_dot_green" />

</FrameLayout>
