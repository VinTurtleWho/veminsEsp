<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingTriggerRoot"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_floating_status_pill"
    android:paddingStart="8dp"
    android:paddingEnd="10dp"
    android:clickable="true"
    android:focusable="false">

    <!-- Stark White "V" Monogram Glyph -->
    <TextView
        android:id="@+id/tvTriggerMonogram"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:text="V"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_monogram_badge" />

    <!-- Live Telemetry Readout: FPS & Latency -->
    <LinearLayout
        android:id="@+id/llTriggerTelemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/tvTriggerFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120 FPS"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvTriggerLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.4ms"
            android:textColor="#888888"
            android:textSize="8sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Status Dot -->
    <View
        android:id="@+id/vStatusDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_status_dot_white" />

</LinearLayout>
